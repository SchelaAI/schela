# =========================================================
# SCHELA — REQUIRED ENVIRONMENT VARIABLES
# Original provider/env set supplied for the project
# =========================================================

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Calendly
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Resend / inbound email
EMAIL_REPLY_TO=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
RESEND_WEBHOOK_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Schela AI
GROQ_API_KEY=

# =========================================================
# ADDED REQUIRED PRODUCTION SECRETS
# =========================================================

# Meta App Secret. Different from WHATSAPP_WEBHOOK_VERIFY_TOKEN.
# Used to validate x-hub-signature-256 on incoming WhatsApp webhooks.
WHATSAPP_APP_SECRET=

# Protects POST /api/cron/followups when called by cron-job.org.
# Configure cron-job.org with:
# Authorization: Bearer <this value>
CRON_SECRET=
